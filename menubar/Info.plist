<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>MacBar</string>
	<key>CFBundleIdentifier</key>
	<string>local.macbar</string>
	<key>CFBundleExecutable</key>
	<string>MacBar</string>
	<key>CFBundleVersion</key>
	<string>1.0</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- Menu bar only: no Dock icon, no app switcher entry. -->
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<!-- For the meetings section. Without these macOS refuses calendar access
	     without asking. The first is read from macOS 14, the second before it. -->
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>MacBar lists today's meetings and reminds you before each one starts.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>MacBar lists today's meetings and reminds you before each one starts.</string>
</dict>
</plist>
